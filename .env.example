# Local Ollama endpoint and model. No API key is needed for local inference.
JARVIS_OLLAMA_URL=http://localhost:11434
JARVIS_MODEL=qwen3.5:2b
JARVIS_DB_PATH=data/jarvis.db
JARVIS_REQUEST_TIMEOUT=120

# Optional Moltbook access. Keep the key out of Git and chat.
# Only sent to https://www.moltbook.com/api/v1/* by Jarvis.
# MOLTBOOK_API_KEY=

# Autonomous social mode is OFF by default. Opt in only after reviewing safeguards.
# Hard limits: 5 comment attempts per UTC day; at most 1 original post per 24 hours.
JARVIS_AUTONOMOUS_SOCIAL=false

# Guarded code maintenance is also OFF by default.
# It only edits allowlisted project files and merges a PR after local tests and green GitHub CI.
JARVIS_AUTONOMOUS_DEVELOPMENT=false
