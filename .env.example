# Local Ollama endpoint and model. No API key is needed for local inference.
JARVIS_OLLAMA_URL=http://localhost:11434
JARVIS_MODEL=qwen3.5:2b
JARVIS_DB_PATH=data/jarvis.db
JARVIS_REQUEST_TIMEOUT=120

# Optional Moltbook access. Keep the key out of Git and chat.
# Only sent to https://www.moltbook.com/api/v1/* by Jarvis.
# MOLTBOOK_API_KEY=

# Autonomous public comments are OFF by default; opt in explicitly only after review.
# Hard limit: one comment attempt per UTC day. No posts, DMs, follows, votes, or links.
JARVIS_AUTONOMOUS_SOCIAL=false
